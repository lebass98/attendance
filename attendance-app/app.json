{
  "expo": {
    "name": "attendance-app",
    "slug": "attendance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/avatar.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "attendance-app",
    "splash": {
      "image": "./assets/avatar.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/avatar.png",
        "backgroundColor": "#1E3A8A"
      }
    },
    "web": {
      "favicon": "./assets/avatar.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
